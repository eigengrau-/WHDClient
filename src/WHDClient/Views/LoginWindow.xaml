<Window x:Class="WHDClient.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:beh="clr-namespace:WHDClient.Behaviors"
        Title="WHD Client — Sign In" Width="440" Height="490"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{DynamicResource BgBrush}">
    <Grid Margin="36">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <Image Source="pack://application:,,,/Assets/life-preserver.png"
                       Width="40" Height="40" Margin="0,0,10,0"/>
                <TextBlock Text="WHD Client" Style="{DynamicResource HeaderText}" FontSize="{DynamicResource FontSize28}" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="Web Help Desk monitoring client" Style="{DynamicResource DimText}" Margin="0,4,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <TextBlock Text="Web Help Desk URL" Margin="0,0,0,4"/>
            <TextBox Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Text="Tech API key" Margin="0,14,0,4"/>
            <PasswordBox x:Name="ApiKeyBox" PasswordChanged="ApiKeyBox_PasswordChanged"/>
            <TextBlock Style="{DynamicResource DimText}" Margin="0,4,0,0">
                Get your key:
                <Hyperlink Command="{Binding OpenApiKeyPageCommand}">
                    WHD → Setup → Techs → My Account → API Key
                </Hyperlink>
            </TextBlock>

            <CheckBox Content="Remember my key on this machine (encrypted)"
                      IsChecked="{Binding RememberKey}" Margin="0,14,0,0"/>

            <Button Style="{DynamicResource AccentButton}"
                    AutomationProperties.Name="Sign in"
                    Command="{Binding SignInCommand}" IsDefault="True"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                    Margin="0,18,0,0" Padding="12,8" HorizontalContentAlignment="Center">
                <StackPanel Orientation="Horizontal">
                     <Image Source="pack://application:,,,/Assets/icons/sign-in.png" Width="16" Height="16" Margin="0,0,8,0" beh:IconTint.Tint="{DynamicResource TextBrush}"/>
                    <TextBlock Text="Sign in" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <ProgressBar IsIndeterminate="True" Margin="0,10,0,0"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisConverter}}"/>

            <TextBlock Text="{Binding ErrorMessage}" Foreground="#c0504d" Margin="0,10,0,0"/>
        </StackPanel>
    </Grid>
</Window>
