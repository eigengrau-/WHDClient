<Window x:Class="WHDClient.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:beh="clr-namespace:WHDClient.Behaviors"
        xmlns:vm="clr-namespace:WHDClient.ViewModels"
        xmlns:views="clr-namespace:WHDClient.Views"
        Title="WHD Client" Width="1564" Height="830.6667" MinWidth="1000" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:MyTicketsViewModel}"><views:MyTicketsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SearchViewModel}"><views:SearchView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:QueueViewModel}"><views:QueueView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:BookmarksViewModel}"><views:BookmarksView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:TicketTabViewModel}"><views:TicketTabView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:CreateTicketViewModel}"><views:CreateTicketView/></DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="210"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left navigation -->
        <Border Background="{DynamicResource Panel2Brush}" BorderBrush="{DynamicResource BorderBrushDim}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header: logo + title + collapse/expand toggle -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="SidebarHeaderContent" Margin="16,20,12,10">
                        <!-- DockPanel lets the title trim instead of overflowing under the toggle button -->
                        <DockPanel>
                            <Image Source="pack://application:,,,/Assets/life-preserver.png"
                                   Width="26" Height="26" Margin="0,0,8,0" DockPanel.Dock="Left"/>
                            <TextBlock Text="WHD Client" Style="{DynamicResource HeaderText}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <TextBlock Text="{Binding UserDisplay}" Style="{DynamicResource DimText}" Margin="0,4,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <ToggleButton Grid.Column="1" x:Name="SidebarToggle" VerticalAlignment="Top"
                                  Margin="0,16,8,0" Padding="5,2" Background="Transparent" BorderThickness="0"
                                  ToolTip="Collapse sidebar" AutomationProperties.Name="Collapse sidebar"
                                  Checked="SidebarToggle_Checked" Unchecked="SidebarToggle_Unchecked">
                        <TextBlock x:Name="SidebarToggleGlyph" Text="❮" FontSize="{DynamicResource FontSize12}"/>
                    </ToggleButton>
                </Grid>

                <StackPanel x:Name="SidebarNav" Grid.Row="1" Margin="10,6">
                    <Button Command="{Binding ShowPageCommand}" CommandParameter="mine"
                            AutomationProperties.Name="My Tickets"
                            HorizontalContentAlignment="Left" Margin="0,2">
                        <StackPanel Orientation="Horizontal">
                             <Image Source="pack://application:,,,/Assets/icons/my-tickets.png" Width="14" Height="14" Margin="0,0,8,0" beh:IconTint.Tint="{DynamicResource TextBrush}"/>
                            <TextBlock Text="My Tickets" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ShowPageCommand}" CommandParameter="search"
                            AutomationProperties.Name="Search"
                            HorizontalContentAlignment="Left" Margin="0,2">
                        <StackPanel Orientation="Horizontal">
                             <Image Source="pack://application:,,,/Assets/icons/search.png" Width="14" Height="14" Margin="0,0,8,0" beh:IconTint.Tint="{DynamicResource TextBrush}"/>
                            <TextBlock Text="Search" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ShowPageCommand}" CommandParameter="queue"
                            AutomationProperties.Name="Ticket Queue"
                            HorizontalContentAlignment="Left" Margin="0,2">
                        <StackPanel Orientation="Horizontal">
                             <Image Source="pack://application:,,,/Assets/icons/ticket-queue.png" Width="14" Height="14" Margin="0,0,8,0" beh:IconTint.Tint="{DynamicResource TextBrush}"/>
                            <TextBlock Text="Ticket Queue" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ShowPageCommand}" CommandParameter="bookmarks"
                            AutomationProperties.Name="Bookmarks"
                            HorizontalContentAlignment="Left" Margin="0,2">
                        <StackPanel Orientation="Horizontal">
                             <Image Source="pack://application:,,,/Assets/icons/bookmark.png" Width="14" Height="14" Margin="0,0,8,0" beh:IconTint.Tint="{DynamicResource TextBrush}"/>
                            <TextBlock Text="Bookmarks" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ShowPageCommand}" CommandParameter="settings"
                            AutomationProperties.Name="Settings"
                            HorizontalContentAlignment="Left" Margin="0,2">
                        <StackPanel Orientation="Horizontal">
                             <Image Source="pack://application:,,,/Assets/icons/settings.png" Width="14" Height="14" Margin="0,0,8,0" beh:IconTint.Tint="{DynamicResource TextBrush}"/>
                            <TextBlock Text="Settings" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Separator/>

                    <Button Style="{DynamicResource AccentButton}"
                            AutomationProperties.Name="New Ticket"
                            Command="{Binding OpenNewTicketCommand}" HorizontalContentAlignment="Left" Margin="0,2">
                        <StackPanel Orientation="Horizontal">
                             <Image Source="pack://application:,,,/Assets/icons/new-ticket.png" Width="14" Height="14" Margin="0,0,8,0" beh:IconTint.Tint="{DynamicResource TextBrush}"/>
                            <TextBlock Text="New Ticket" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <TextBlock Text="Open ticket #" Margin="4,16,0,4" Style="{DynamicResource DimText}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TicketNumberBox" KeyDown="TicketNumberBox_KeyDown"/>
                        <Button Grid.Column="1" Content="Open" Margin="4,0,0,0" Padding="8,4"
                                Command="{Binding OpenTicketByNumberCommand}"
                                CommandParameter="{Binding Text, ElementName=TicketNumberBox}"/>
                    </Grid>
                </StackPanel>

                <StackPanel x:Name="SidebarBottom" Grid.Row="2" Margin="10,10">
                    <!-- Notifications -->
                    <ToggleButton x:Name="NotifyToggle" Padding="8,6" HorizontalContentAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔔 "/>
                            <TextBlock Text="Notifications"/>
                            <Border Background="{DynamicResource HeaderBrush}" CornerRadius="8" Margin="6,0,0,0"
                                    Padding="6,1" Visibility="{Binding Notifications.UnreadCount, Converter={StaticResource PositiveIntToVisConverter}}">
                                <TextBlock Text="{Binding Notifications.UnreadCount}" Foreground="White" FontSize="{DynamicResource FontSize10}"/>
                            </Border>
                        </StackPanel>
                    </ToggleButton>
                    <Popup Placement="Top" PlacementTarget="{Binding ElementName=NotifyToggle}"
                           IsOpen="{Binding IsChecked, ElementName=NotifyToggle, Mode=TwoWay}"
                           StaysOpen="False" Width="380" MaxHeight="420">
                        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource HeaderBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <DockPanel>
                                    <TextBlock Text="Notifications" Style="{DynamicResource SubHeaderText}" DockPanel.Dock="Left"/>
                                </DockPanel>
                                <ScrollViewer Grid.Row="1" MaxHeight="360" VerticalScrollBarVisibility="Auto"
                                              beh:ScrollWheelSpeed.PixelsPerNotch="24">
                                    <ItemsControl ItemsSource="{Binding Notifications.Notifications}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource BorderBrushDim}" BorderThickness="0,0,0,1"
                                                        Padding="2,6" MouseLeftButtonUp="Notification_Click" Cursor="Hand"
                                                        Tag="{Binding}">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{DynamicResource HeaderBrush}"/>
                                                        <TextBlock Text="{Binding Message}" FontSize="{DynamicResource FontSize12}"/>
                                                        <TextBlock Text="Open download page" FontSize="{DynamicResource FontSize12}" Foreground="{DynamicResource LinkBrush}"
                                                                   Visibility="{Binding Url, Converter={StaticResource NullToVisConverter}}"/>
                                                        <TextBlock Text="{Binding TimeDisplay}" Style="{DynamicResource DimText}"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Popup>

                    <TextBlock Text="{Binding StatusText}" Style="{DynamicResource DimText}" Margin="4,10,4,4"
                               TextWrapping="Wrap"/>
                    <Button Command="{Binding SignOutCommand}" AutomationProperties.Name="Sign out" HorizontalContentAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                             <Image Source="pack://application:,,,/Assets/icons/sign-out.png" Width="14" Height="14" Margin="0,0,8,0" beh:IconTint.Tint="{DynamicResource TextBrush}"/>
                            <TextBlock Text="Sign out" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Tab content -->
        <TabControl Grid.Column="1" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}"
                    BorderThickness="0" Padding="4">
            <TabControl.ItemTemplate>
                <DataTemplate>
                    <DockPanel>
                        <Button Content="✕" DockPanel.Dock="Right" Padding="4,0" Margin="4,0,0,0"
                                FontSize="{DynamicResource FontSize10}" Background="Transparent" BorderThickness="0"
                                Command="{Binding CloseCommand}"
                                Visibility="{Binding IsClosable, Converter={StaticResource BoolToVisConverter}}"/>
                         <Image Source="{Binding IconSource}" Width="12" Height="12" Margin="0,0,6,0" beh:IconTint.Tint="{DynamicResource TextBrush}" Visibility="{Binding IconSource, Converter={StaticResource NullToVisConverter}}"/>
                        <TextBlock Text="{Binding Header}"/>
                    </DockPanel>
                </DataTemplate>
            </TabControl.ItemTemplate>
        </TabControl>
    </Grid>
</Window>
