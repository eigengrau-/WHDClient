<UserControl x:Class="WHDClient.Views.TicketTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:WHDClient.Views"
             xmlns:beh="clr-namespace:WHDClient.Behaviors">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Background="{DynamicResource PanelBrush}" CornerRadius="4" Padding="12,8" Margin="0,0,0,6">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Style="{DynamicResource SelectableText}" VerticalAlignment="Center"
                             Foreground="{DynamicResource HeaderBrush}" FontSize="{DynamicResource FontSize18}" FontWeight="SemiBold">
                        <TextBox.Text>
                            <MultiBinding StringFormat="#{0} {1}">
                                <Binding Path="Ticket.Id" Mode="OneWay"/>
                                <Binding Path="Ticket.DisplaySubject" Mode="OneWay"/>
                            </MultiBinding>
                        </TextBox.Text>
                    </TextBox>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Command="{Binding ToggleBookmarkCommand}" ToolTip="{Binding BookmarkLabel}"
                                AutomationProperties.Name="{Binding BookmarkLabel}" Padding="6,3" Margin="4,0">
                            <StackPanel Orientation="Horizontal">
                                 <Image Source="{Binding BookmarkIconSource}" Width="14" Height="14" Margin="0,0,6,0" beh:IconTint.Tint="{DynamicResource TextBrush}"/>
                                <TextBlock Text="{Binding BookmarkLabel}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding RefreshCommand}" AutomationProperties.Name="Refresh" Padding="10,3" Margin="4,0">
                            <StackPanel Orientation="Horizontal">
                                 <Image Source="pack://application:,,,/Assets/icons/refresh.png" Width="14" Height="14" Margin="0,0,6,0" beh:IconTint.Tint="{DynamicResource TextBrush}"/>
                                <TextBlock Text="Refresh" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding OpenInBrowserCommand}" AutomationProperties.Name="Open in browser"
                                Padding="10,3" Margin="4,0">
                            <StackPanel Orientation="Horizontal">
                                 <Image Source="pack://application:,,,/Assets/icons/link.png" Width="14" Height="14" Margin="0,0,6,0" beh:IconTint.Tint="{DynamicResource TextBrush}"/>
                                <TextBlock Text="Open in browser" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Ticket meta: compact inline label + value fields (no REQUEST TYPE here — it is set in the fields below) -->
                <Border Background="{DynamicResource Panel2Brush}" CornerRadius="4" Padding="10,6" Margin="0,8,0,0">
                    <WrapPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,1,22,1">
                            <Label Content="CLIENT" Style="{DynamicResource PropertyLabel}" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding Ticket.ClientReporter.DisplayName, Mode=OneWay}" Style="{DynamicResource PropertyBox}"
                                     Width="170" Margin="6,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,1,22,1">
                            <Label Content="LOCATION" Style="{DynamicResource PropertyLabel}" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding Ticket.Location.DisplayName, Mode=OneWay}" Style="{DynamicResource PropertyBox}"
                                     Width="170" Margin="6,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,1,22,1">
                            <Label Content="REPORTED" Style="{DynamicResource PropertyLabel}" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding Ticket.ReportDateUtc, Converter={StaticResource DateTimeLocalConverter}, Mode=OneWay}"
                                     Style="{DynamicResource PropertyBox}" Width="150" Margin="6,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,1,22,1">
                            <Label Content="UPDATED" Style="{DynamicResource PropertyLabel}" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding Ticket.EffectiveLastUpdated, Converter={StaticResource DateTimeLocalConverter}, Mode=OneWay}"
                                     Style="{DynamicResource PropertyBox}" Width="150" Margin="6,0,0,0"/>
                        </StackPanel>
                    </WrapPanel>
                </Border>

                <!-- Request detail: hidden when it just repeats the subject -->
                <Border BorderBrush="{DynamicResource HeaderBrush}" BorderThickness="3,0,0,0"
                        Background="{DynamicResource Panel2Brush}" Padding="10,5" Margin="0,6,0,0"
                        Visibility="{Binding HasDistinctDetail, Converter={StaticResource BoolToVisConverter}}">
                    <ScrollViewer MaxHeight="130" VerticalScrollBarVisibility="Auto"
                                  beh:ScrollWheelSpeed.PixelsPerNotch="24">
                        <RichTextBox beh:BbCode.Text="{Binding Ticket.DisplayDetail, Mode=OneWay}"
                                     Style="{DynamicResource SelectableRichText}"
                                     FontSize="{DynamicResource FontSize12}"/>
                    </ScrollViewer>
                </Border>

                <!-- Editable fields -->
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="STATUS" Style="{DynamicResource FieldLabel}"/>
                            <StackPanel Orientation="Horizontal">
                                <ComboBox ItemsSource="{Binding StatusTypes}" SelectedItem="{Binding SelectedStatus}"
                                          DisplayMemberPath="DisplayName" Width="150" Margin="0"/>
                                <Ellipse Width="10" Height="10" Margin="8,0,0,0" VerticalAlignment="Center"
                                         Fill="{Binding SelectedStatus.DisplayName, Converter={StaticResource StatusToBrushConverter}}"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="PRIORITY" Style="{DynamicResource FieldLabel}"/>
                            <StackPanel Orientation="Horizontal">
                                <ComboBox ItemsSource="{Binding PriorityTypes}" SelectedItem="{Binding SelectedPriority}"
                                          DisplayMemberPath="DisplayName" Width="130" Margin="0"/>
                                <Ellipse Width="10" Height="10" Margin="8,0,0,0" VerticalAlignment="Center"
                                         Fill="{Binding SelectedPriority.DisplayName, Converter={StaticResource PriorityToBrushConverter}}"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="TECH" Style="{DynamicResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding Techs}" SelectedItem="{Binding SelectedTech}"
                                      DisplayMemberPath="ListDisplayName" Width="170" Margin="0"/>
                        </StackPanel>
                        <StackPanel VerticalAlignment="Bottom">
                            <TextBlock Text="REQUEST TYPE" Style="{DynamicResource FieldLabel}"/>
                            <!-- Cascading picker, loads lazily after the page renders -->
                            <views:RequestTypePicker DataContext="{Binding RequestTypePicker}" Margin="0"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Margin="0,6,0,0">
                        <CheckBox Content="Send update email" IsChecked="{Binding SendUpdateEmail}"
                                  ToolTip="When unchecked, the client and tech are not emailed about these changes"
                                  VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Button Content="Save changes" Style="{DynamicResource AccentButton}"
                                Command="{Binding SaveChangesCommand}" Padding="14,6"/>
                    </StackPanel>
                </Grid>

                <!-- Status/error lines: collapsed (no vertical space) until they have content -->
                <TextBlock Text="{Binding InfoMessage}" Foreground="{DynamicResource HeaderBrush}" Margin="0,4,0,0"
                           Visibility="{Binding InfoMessage, Converter={StaticResource StringToVisConverter}}"/>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#c0504d" Margin="0,4,0,0"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisConverter}}"/>
            </StackPanel>
        </Border>

        <!-- Busy indicator while refreshing / saving -->
        <ProgressBar Grid.Row="1" IsIndeterminate="True" Margin="0,0,0,6"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisConverter}}"/>

        <!-- Body: notes + attachments | reply -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Notes timeline -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,10,0"
                              beh:ScrollWheelSpeed.PixelsPerNotch="24">
                    <ItemsControl ItemsSource="{Binding Notes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource Panel2Brush}" BorderBrush="{DynamicResource BorderBrushDim}"
                                        BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,8">
                                    <StackPanel>
                                        <DockPanel>
                                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                                <TextBox Text="{Binding AuthorDisplay, Mode=OneWay}" Style="{DynamicResource SelectableText}" FontWeight="SemiBold"/>
                                                <TextBlock Text=" (hidden)" Foreground="#c0504d"
                                                           Visibility="{Binding IsHidden, Converter={StaticResource BoolToVisConverter}}"/>
                                            </StackPanel>
                                            <TextBox Text="{Binding EffectiveDate, Converter={StaticResource DateTimeLocalConverter}, Mode=OneWay}"
                                                     Style="{DynamicResource SelectableText}" Foreground="{DynamicResource TextDimBrush}" FontSize="{DynamicResource FontSize11}"
                                                     HorizontalAlignment="Right"/>
                                        </DockPanel>
                                        <RichTextBox beh:BbCode.Text="{Binding DisplayText, Mode=OneWay}"
                                                     Style="{DynamicResource SelectableRichText}" Margin="0,4,0,0" FontSize="{DynamicResource FontSize12}"/>
                                        <ItemsControl ItemsSource="{Binding Attachments}" Margin="0,6,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock>
                                                        <Hyperlink Command="{Binding DataContext.DownloadAttachmentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=2}}"
                                                                   CommandParameter="{Binding}">
                                                            <Run Text="📎 "/><Run Text="{Binding DisplayName, Mode=OneWay}"/>
                                                        </Hyperlink>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Ticket-level attachments -->
                <Border Grid.Row="1" Background="{DynamicResource Panel2Brush}" CornerRadius="4" Padding="10" Margin="0,4,10,0">
                    <StackPanel>
                        <TextBlock Text="Ticket attachments" Style="{DynamicResource SubHeaderText}" FontSize="{DynamicResource FontSize12}"/>
                        <ItemsControl ItemsSource="{Binding Ticket.Attachments}" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="0,1">
                                        <Hyperlink Command="{Binding DataContext.DownloadAttachmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding}">
                                            <Run Text="📎 "/><Run Text="{Binding DisplayName, Mode=OneWay}"/>
                                        </Hyperlink>
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Vertical splitter: drag to balance the notes timeline against the reply editor -->
            <GridSplitter Grid.Column="1" Width="8" Margin="0,0,4,0" HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                          Background="{DynamicResource BorderBrushDim}" Cursor="SizeWE"
                          ToolTip="Drag to resize the notes/reply columns"
                          AutomationProperties.Name="Resize notes/reply split"/>

            <!-- Reply panel -->
            <Border Grid.Column="2" Background="{DynamicResource PanelBrush}" CornerRadius="4" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="2*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <TextBlock Text="Reply (tech note)" Style="{DynamicResource SubHeaderText}" DockPanel.Dock="Left"/>
                        <views:BbCodeToolbar Target="{Binding ElementName=ReplyBox}" DockPanel.Dock="Right"
                                             HorizontalAlignment="Right"/>
                    </DockPanel>
                    <TextBox x:Name="ReplyBox" Grid.Row="1" Text="{Binding ReplyText, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top" Margin="0,8" MinHeight="60"/>
                    <!-- Drag to resize the reply box vertically; both the editor row and the
                         controls row below are star-sized so the splitter can grow OR shrink it. -->
                    <GridSplitter Grid.Row="2" Height="8" HorizontalAlignment="Stretch" Margin="0,2"
                                  ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                                  Background="{DynamicResource BorderBrushDim}" Cursor="SizeNS"
                                  ToolTip="Drag to resize the reply box"
                                  AutomationProperties.Name="Resize reply box"/>
                    <StackPanel Grid.Row="3" VerticalAlignment="Top">
                        <WrapPanel>
                            <CheckBox Content="Email client" IsChecked="{Binding ReplyEmailClient}" Margin="0,0,10,2"/>
                            <CheckBox Content="Email tech" IsChecked="{Binding ReplyEmailTech}" Margin="0,0,10,2"/>
                            <CheckBox Content="Hidden" IsChecked="{Binding ReplyHidden}" Margin="0,0,10,2"/>
                            <CheckBox Content="Solution" IsChecked="{Binding ReplyIsSolution}" Margin="0,0,10,2"/>
                            <CheckBox Content="Also set status" IsChecked="{Binding ReplyAlsoSetStatus}" Margin="0,0,10,2"/>
                        </WrapPanel>

                        <!-- Cc recipients: search techs/clients, pick from the dropdown, accumulates as chips -->
                        <StackPanel Margin="0,4,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Cc:" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding CcSearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="6,0,0,0">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding SearchCcCommand}"/>
                                    </TextBox.InputBindings>
                                </TextBox>
                                <Button Grid.Column="2" Content="Find" Command="{Binding SearchCcCommand}"
                                        AutomationProperties.Name="Find Cc" Margin="6,0,0,0" Padding="10,3"/>
                            </Grid>
                            <ProgressBar IsIndeterminate="True" Height="3" Margin="24,2,0,0"
                                         Visibility="{Binding IsSearchingCc, Converter={StaticResource BoolToVisConverter}}"/>
                            <ComboBox x:Name="CcCombo" ItemsSource="{Binding CcResults}" SelectedItem="{Binding SelectedCcResult}"
                                      DisplayMemberPath="Label" Margin="24,4,0,0" MaxDropDownHeight="240"
                                      Visibility="{Binding CcResults.Count, Converter={StaticResource PositiveIntToVisConverter}}"/>
                            <ItemsControl ItemsSource="{Binding CcRecipients}" Margin="24,4,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource Panel2Brush}" BorderBrush="{DynamicResource BorderBrushDim}"
                                                BorderThickness="1" CornerRadius="3" Padding="6,1" Margin="0,0,4,2">
                                            <DockPanel>
                                                <Button Content="✕" DockPanel.Dock="Right" Padding="5,0" FontSize="{DynamicResource FontSize10}"
                                                        Background="Transparent" BorderThickness="0"
                                                        Command="{Binding DataContext.RemoveCcRecipientCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"/>
                                                <TextBlock Text="{Binding Label}" FontSize="{DynamicResource FontSize11}" VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Note attachments: staged here, uploaded onto the note when it is posted -->
                        <StackPanel Margin="0,4,0,0">
                            <Button Content="+ Add file" Command="{Binding AddReplyAttachmentsCommand}" AutomationProperties.Name="Add file"
                                    Padding="8,2" HorizontalAlignment="Left"/>
                            <ItemsControl ItemsSource="{Binding PendingReplyAttachments}" Margin="0,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,1">
                                            <Button Content="✕" DockPanel.Dock="Right" Padding="5,0" FontSize="{DynamicResource FontSize10}"
                                                    Background="Transparent" BorderThickness="0"
                                                    Command="{Binding DataContext.RemoveReplyAttachmentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"/>
                                            <TextBlock Text="{Binding}" Style="{DynamicResource DimText}" FontSize="{DynamicResource FontSize12}"
                                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <Grid Margin="0,6,0,0">
                            <Button Content="Add note" Style="{DynamicResource AccentButton}"
                                    Command="{Binding ReplyCommand}" Padding="12,5" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
