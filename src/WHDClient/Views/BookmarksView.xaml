<UserControl x:Class="WHDClient.Views.BookmarksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,8">
            <TextBlock Text="Bookmarks" Style="{StaticResource SubHeaderText}" DockPanel.Dock="Left"/>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                <TextBlock Text="{Binding LastRefreshText, StringFormat='refreshed {0}'}"
                           Style="{StaticResource DimText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Button Command="{Binding RefreshCommand}" AutomationProperties.Name="Refresh" Padding="10,3">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="pack://application:,,,/Assets/icons/refresh.png" Width="14" Height="14" Margin="0,0,6,0"/>
                        <TextBlock Text="Refresh" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </DockPanel>

        <DataGrid Grid.Row="1" ItemsSource="{Binding Tickets}" MouseDoubleClick="Row_DoubleClick" Loaded="Grid_Loaded">
            <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="60" ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn Header="Subject" Binding="{Binding Subject}" Width="3*" ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn Header="Client" Binding="{Binding Client}" Width="*" ElementStyle="{StaticResource CellText}"/>
                <DataGridTemplateColumn Header="Status" Width="70" SortMemberPath="Status">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Ellipse Width="12" Height="12" HorizontalAlignment="Center"
                                     Fill="{Binding Status, Converter={StaticResource StatusToBrushConverter}}"
                                     ToolTip="{Binding Status}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Priority" Width="70" SortMemberPath="Priority">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Ellipse Width="12" Height="12" HorizontalAlignment="Center"
                                     Fill="{Binding Priority, Converter={StaticResource PriorityToBrushConverter}}"
                                     ToolTip="{Binding Priority}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="*" ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn Header="Tech" Binding="{Binding Tech}" Width="*" ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn Header="Reported" Binding="{Binding ReportDate}" Width="110" ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn Header="Updated" Binding="{Binding LastUpdated}" Width="110" ElementStyle="{StaticResource CellText}"/>
                <DataGridTemplateColumn Header="" Width="50" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button ToolTip="Remove bookmark" AutomationProperties.Name="Remove bookmark"
                                    Command="{Binding DataContext.RemoveBookmarkCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}" Padding="6,2" HorizontalAlignment="Center">
                                <Image Source="pack://application:,,,/Assets/icons/remove-bookmark.png" Width="13" Height="13"/>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="2" Margin="0,6,0,0">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                <Button Content="Prev" Command="{Binding PreviousPageCommand}" IsEnabled="{Binding CanGoPrevious}" Padding="10,2"/>
                <TextBlock Text="{Binding PageText}" Style="{StaticResource DimText}" VerticalAlignment="Center" Margin="10,0"/>
                <Button Content="Next" Command="{Binding NextPageCommand}" IsEnabled="{Binding HasNextPage}" Padding="10,2"/>
                <TextBlock Text="{Binding CountText}" Style="{StaticResource DimText}" VerticalAlignment="Center" Margin="10,0"/>
                <Button Content="Count" Command="{Binding CountTotalCommand}" IsEnabled="{Binding IsNotCounting}" Padding="10,2"
                        ToolTip="Count all matching tickets (pages the server; can take a few seconds)"/>
            </StackPanel>
            <StackPanel>
                <ProgressBar IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisConverter}}"/>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#c0504d"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</UserControl>
