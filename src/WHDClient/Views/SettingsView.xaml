<UserControl x:Class="WHDClient.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:beh="clr-namespace:WHDClient.Behaviors">
    <DockPanel>
        <!-- Fixed footer: Save stays visible regardless of window height -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrushDim}" BorderThickness="0,1,0,0" Padding="16,10">
            <StackPanel MaxWidth="640" HorizontalAlignment="Left" Orientation="Horizontal">
                <Button Content="Save settings" Style="{DynamicResource AccentButton}" Command="{Binding SaveCommand}" Padding="14,6"/>
                <TextBlock Text="{Binding SavedMessage}" Style="{DynamicResource DimText}" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      beh:ScrollWheelSpeed.PixelsPerNotch="24">
            <StackPanel Margin="16">
                <TextBlock Text="Settings" Style="{DynamicResource HeaderText}"/>
                <TextBlock Text="{Binding CurrentUserText}" Style="{DynamicResource DimText}" Margin="0,4,0,12"/>

                <!-- Sections side by side in cards -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Column 1: Connection + Updates -->
                    <StackPanel>
                        <Border Background="{DynamicResource PanelBrush}" CornerRadius="4" Padding="12" Margin="0,0,10,10">
                            <StackPanel>
                                <TextBlock Text="Connection" Style="{DynamicResource SubHeaderText}"/>
                                <TextBlock Text="Server URL" Style="{DynamicResource DimText}" Margin="0,6,0,2"/>
                                <TextBox Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="Poll interval (seconds, min 15)" Style="{DynamicResource DimText}" Margin="0,8,0,2"/>
                                <TextBox Text="{Binding PollIntervalSeconds, UpdateSourceTrigger=PropertyChanged}" Width="80" HorizontalAlignment="Left"/>
                                <TextBlock Text="Tickets per page (smaller pages load faster)" Style="{DynamicResource DimText}" Margin="0,8,0,2"/>
                                <ComboBox ItemsSource="{Binding PageSizeOptions}" SelectedItem="{Binding PageSize}"
                                          Width="80" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource PanelBrush}" CornerRadius="4" Padding="12" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="Updates" Style="{DynamicResource SubHeaderText}"/>
                                <TextBlock Text="{Binding CurrentVersionText}" Style="{DynamicResource DimText}" Margin="0,6,0,2"/>
                                <TextBlock Text="{Binding UpdateStatus}" Style="{DynamicResource DimText}" Margin="0,4,0,0"/>
                                <Button Content="Download update" Command="{Binding OpenUpdateDownloadCommand}"
                                        HorizontalAlignment="Left" Margin="0,6,0,0"
                                        Visibility="{Binding UpdateUrl, Converter={StaticResource NullToVisConverter}}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Column 2: Notifications + Alert filters -->
                    <StackPanel Grid.Column="1">
                        <Border Background="{DynamicResource PanelBrush}" CornerRadius="4" Padding="12" Margin="0,0,10,10">
                            <StackPanel>
                                <TextBlock Text="Notifications" Style="{DynamicResource SubHeaderText}"/>
                                <CheckBox Content="Enable Windows toast notifications" IsChecked="{Binding NotificationsEnabled}" Margin="0,6,0,0"/>
                                <CheckBox Content="When a ticket is assigned to me" IsChecked="{Binding NotifyAssignedToMe}"/>
                                <CheckBox Content="When one of my tickets is updated" IsChecked="{Binding NotifyMyTicketUpdated}"/>
                                <CheckBox Content="When a new ticket matches an alert filter" IsChecked="{Binding NotifyNewMatching}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource PanelBrush}" CornerRadius="4" Padding="12" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="Alert filters" Style="{DynamicResource SubHeaderText}"/>
                                <TextBlock Text="Saved filters that trigger notifications on new matches"
                                           Style="{DynamicResource DimText}" Margin="0,4,0,4"/>
                                <ItemsControl ItemsSource="{Binding AlertFilters}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,1">
                                                <CheckBox IsChecked="{Binding AlertOnNew}"
                                                          Click="AlertFilter_Click" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Create filters on the Search page, then enable alerts here."
                                           Style="{DynamicResource DimText}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Column 3: Appearance + Sign-in -->
                    <StackPanel Grid.Column="2">
                        <Border Background="{DynamicResource PanelBrush}" CornerRadius="4" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Appearance" Style="{DynamicResource SubHeaderText}"/>
                                <TextBlock Text="Theme" Style="{DynamicResource DimText}" Margin="0,6,0,2"/>
                                <ComboBox ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding Theme}"
                                          Width="140" HorizontalAlignment="Left"/>
                                <TextBlock Text="Font size" Style="{DynamicResource DimText}" Margin="0,8,0,2"/>
                                <ComboBox ItemsSource="{Binding FontScaleOptions}" SelectedItem="{Binding FontScale}"
                                          Width="140" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource PanelBrush}" CornerRadius="4" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Ticket list columns" Style="{DynamicResource SubHeaderText}"/>
                                <TextBlock Text="Show or hide columns on all ticket lists. Drag column headers to reorder or edges to resize; the layout is remembered."
                                           Style="{DynamicResource DimText}" Margin="0,4,0,4" TextWrapping="Wrap"/>
                                <ItemsControl ItemsSource="{Binding ColumnToggles}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsVisible}" Margin="0,1"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource PanelBrush}" CornerRadius="4" Padding="12" Margin="0,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Sign-in" Style="{DynamicResource SubHeaderText}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Button Content="Forget remembered API key" Command="{Binding ForgetApiKeyCommand}"
                                            IsEnabled="{Binding HasRememberedKey}"/>
                                    <Button Content="Sign out" Command="{Binding SignOutCommand}" Margin="8,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
