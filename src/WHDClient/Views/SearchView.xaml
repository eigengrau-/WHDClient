<UserControl x:Class="WHDClient.Views.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:WHDClient.Views"
             xmlns:beh="clr-namespace:WHDClient.Behaviors">
    <UserControl.InputBindings>
        <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
    </UserControl.InputBindings>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Filter fields, two columns like the WHD basic search -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Ticket No." VerticalAlignment="Center" Margin="0,4"/>
            <TextBox Grid.Column="1" Text="{Binding TicketNumber, UpdateSourceTrigger=PropertyChanged}" Margin="0,4"/>

            <TextBlock Grid.Column="3" Text="Tech" VerticalAlignment="Center" Margin="0,4"/>
            <ComboBox Grid.Column="4" ItemsSource="{Binding Techs}" SelectedItem="{Binding SelectedTech}"
                      DisplayMemberPath="ListDisplayName" Margin="0,4" MaxDropDownHeight="400"/>

            <TextBlock Grid.Row="1" Text="Date" VerticalAlignment="Center" Margin="0,4"/>
            <WrapPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Margin="0,4">
                <RadioButton Content="Opened" IsChecked="{Binding DateOpened}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <RadioButton Content="Closed" IsChecked="{Binding DateClosed}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <RadioButton Content="Updated" IsChecked="{Binding DateUpdated}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,10,0">
                    <TextBlock Text="from" Style="{DynamicResource DimText}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <DatePicker SelectedDate="{Binding DateFrom}" Width="110" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="to" Style="{DynamicResource DimText}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <DatePicker SelectedDate="{Binding DateTo}" Width="110" VerticalAlignment="Center"/>
                </StackPanel>
            </WrapPanel>

            <TextBlock Grid.Row="1" Grid.Column="3" Text="Location" VerticalAlignment="Center" Margin="0,4"/>
            <ComboBox Grid.Row="1" Grid.Column="4" ItemsSource="{Binding Locations}" SelectedItem="{Binding SelectedLocation}"
                      DisplayMemberPath="DisplayName" Margin="0,4" MaxDropDownHeight="400"/>

            <TextBlock Grid.Row="2" Text="Status" VerticalAlignment="Center" Margin="0,4"/>
            <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding StatusTypes}" SelectedItem="{Binding SelectedStatus}"
                      DisplayMemberPath="DisplayName" Margin="0,4" MaxDropDownHeight="400"/>

            <TextBlock Grid.Row="2" Grid.Column="3" Text="Priority" VerticalAlignment="Center" Margin="0,4"/>
            <ComboBox Grid.Row="2" Grid.Column="4" ItemsSource="{Binding PriorityTypes}" SelectedItem="{Binding SelectedPriority}"
                      DisplayMemberPath="DisplayName" Margin="0,4" MaxDropDownHeight="400"/>

            <TextBlock Grid.Row="3" Text="Last Name" VerticalAlignment="Center" Margin="0,4"/>
            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4"/>

            <TextBlock Grid.Row="3" Grid.Column="3" Text="Subject" VerticalAlignment="Center" Margin="0,4"/>
            <TextBox Grid.Row="3" Grid.Column="4" Text="{Binding SubjectContains, UpdateSourceTrigger=PropertyChanged}" Margin="0,4"/>

            <TextBlock Grid.Row="4" Text="Request Type" VerticalAlignment="Center" Margin="0,4"/>
            <views:RequestTypePicker Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="4"
                                     DataContext="{Binding RequestTypePicker}" Margin="0,2" VerticalAlignment="Center"/>
        </Grid>

        <!-- Action buttons -->
        <DockPanel Grid.Row="1" Margin="0,6,0,0">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button Style="{DynamicResource AccentButton}" Command="{Binding SearchCommand}"
                        AutomationProperties.Name="Search" Padding="24,6">
                    <StackPanel Orientation="Horizontal">
                         <Image Source="pack://application:,,,/Assets/icons/search.png" Width="14" Height="14" Margin="0,0,8,0" beh:IconTint.Tint="{DynamicResource TextBrush}"/>
                        <TextBlock Text="Search" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Content="Clear" Command="{Binding ClearCommand}" Margin="8,0,0,0" Padding="16,6"/>
            </StackPanel>
            <TextBlock Text="{Binding LastRefreshText, StringFormat='refreshed {0}'}" Style="{DynamicResource DimText}"
                       DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </DockPanel>

        <!-- Saved filters + raw qualifier -->
        <Expander Grid.Row="2" Header="Saved filters &amp; advanced qualifier" Margin="0,6,0,6" IsExpanded="False">
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Save current filter" Style="{DynamicResource DimText}"/>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding FilterName, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Grid.Column="1" Content="Save" Command="{Binding SaveFilterCommand}" Margin="6,0,0,0" Padding="12,4"/>
                    </Grid>
                    <ListBox ItemsSource="{Binding SavedFilters}" MaxHeight="130" Margin="0,6,0,0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Width="300">
                                    <Button Content="✕" DockPanel.Dock="Right" Padding="4,0" FontSize="{DynamicResource FontSize10}"
                                            Background="Transparent" BorderThickness="0"
                                            Command="{Binding DataContext.DeleteFilterCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}"/>
                                    <TextBlock Text="{Binding Name}" MouseLeftButtonUp="SavedFilter_Click" Cursor="Hand" Tag="{Binding}"/>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="Qualifier (advanced — overrides the fields above)" Style="{DynamicResource DimText}"/>
                    <TextBox Text="{Binding QualifierText, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60"
                             VerticalContentAlignment="Top" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Expander>

        <!-- Results -->
        <DataGrid Grid.Row="3" ItemsSource="{Binding Tickets}" MouseDoubleClick="Row_DoubleClick" Loaded="Grid_Loaded"
                  beh:GridColumnPersistence.Key="Search">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                    <Setter Property="Background" Value="{Binding Status, Converter={StaticResource StatusToTintConverter}}"/>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="60" ElementStyle="{DynamicResource CellText}"/>
                <DataGridTextColumn Header="Subject" Binding="{Binding Subject}" Width="3*" ElementStyle="{DynamicResource CellText}"/>
                <DataGridTextColumn Header="Client" Binding="{Binding Client}" Width="*" ElementStyle="{DynamicResource CellText}"/>
                <DataGridTemplateColumn Header="Status" Width="SizeToHeader" SortMemberPath="Status">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Ellipse Width="12" Height="12" HorizontalAlignment="Center"
                                     Fill="{Binding Status, Converter={StaticResource StatusToBrushConverter}}"
                                     ToolTip="{Binding Status}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Priority" Width="SizeToHeader" SortMemberPath="Priority">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Ellipse Width="12" Height="12" HorizontalAlignment="Center"
                                     Fill="{Binding Priority, Converter={StaticResource PriorityToBrushConverter}}"
                                     ToolTip="{Binding Priority}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Tech" Binding="{Binding Tech}" Width="*" ElementStyle="{DynamicResource CellText}"/>
                <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="*" ElementStyle="{DynamicResource CellText}"/>
                <DataGridTextColumn Header="Updated" Binding="{Binding LastUpdated}" Width="110" ElementStyle="{DynamicResource CellText}"/>
                <DataGridTextColumn Header="Reported" Binding="{Binding ReportDate}" Width="110" ElementStyle="{DynamicResource CellText}"/>
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="4" Margin="0,6,0,0">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                <Button Content="Prev" Command="{Binding PreviousPageCommand}" IsEnabled="{Binding CanGoPrevious}" Padding="10,2"/>
                <TextBlock Text="{Binding PageText}" Style="{DynamicResource DimText}" VerticalAlignment="Center" Margin="10,0"/>
                <Button Content="Next" Command="{Binding NextPageCommand}" IsEnabled="{Binding HasNextPage}" Padding="10,2"/>
                <TextBlock Text="{Binding CountText}" Style="{DynamicResource DimText}" VerticalAlignment="Center" Margin="10,0"/>
                <Button Content="Count" Command="{Binding CountTotalCommand}" IsEnabled="{Binding IsNotCounting}" Padding="10,2"
                        ToolTip="Count all matching tickets (pages the server; can take a few seconds)"/>
            </StackPanel>
            <StackPanel>
                <ProgressBar IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisConverter}}"/>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#c0504d"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</UserControl>
